# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Ignore data folder
/data/

# Ignore environment variables
.env
.env.*
!.env.example

# Python virtualenvs
/backend/.venv/
/backend/backend/.venv/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase Admin SDK service account keys (keep local; never commit)
secrets/
**/*firebase-adminsdk*.json
**/*firebase-admin*.json
**/*serviceAccount*.json
frontend/sportconnect-c34b9-firebase-adminsdk-fbsvc-dd20b22440.json
# typescript
*.tsbuildinfo

app-example

# Python bytecode caches - canonical rule for all nested __pycache__ dirs
**/__pycache__/**

# Android native build outputs
frontend/android/build/
frontend/android/app/build/

# Database context/reference exports that are useful locally but not needed in deploy branch
backend/sql/*_context.csv
backend/sql/supabase.txt
backend/sql/*.png

# Local scratch notes
run.txt

# Context/generated artifacts not required in git history
backend/sql/*.sql
backend/sql/*.csv
sql/*.sql
frontend/data/*.csv

